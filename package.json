{
  "name": "ava-brain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute ava_brain_db --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute ava_brain_db --remote --file=migrations/0001_init.sql",
    "set-webhook": "bash scripts/set-webhook.sh"
  },
  "devDependencies": {
    "wrangler": "^4.86.0"
  }
}
